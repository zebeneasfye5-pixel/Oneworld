# GEMINI_API_KEY: Required for server-side Gemini AI translation & AI Academy (/api/translate, /api/ai/*)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted
APP_URL="MY_APP_URL"

# Global WebRTC TURN Relay Servers (Required for mobile carrier CGNAT, Telegram/IMO WebViews & strict firewalls)
# Recommended providers: Cloudflare Calls TURN, Metered.ca OpenRelay, or self-hosted Coturn
TURN_URL="turn:global.turn.example.com:3478"
TURN_USERNAME="MY_TURN_USERNAME"
TURN_CREDENTIAL="MY_TURN_CREDENTIAL"

# Optional LiveKit SFU Endpoint (Required when scaling single-room live video to thousands/millions of viewers)
LIVEKIT_URL="wss://your-livekit-cluster.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Payment Gateways & Banking Integrations
CHAPA_SECRET_KEY="CHASECK_TEST_XXXXXXXXXXXX"
CHAPA_WEBHOOK_SECRET="chapa_wh_sec_XXXXXXXX"
STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
VITE_CHAPA_PUBLIC_KEY="CHAPUBK_TEST_XXXXXXXX"
VITE_CBE_ACCOUNT_NUMBER="1000167413618"

# Real-time WebRTC / WebSocket & API Backend (When Frontend is on Vercel and Backend is on Render/Cloud Run)
VITE_BACKEND_URL=""
VITE_WS_URL=""
